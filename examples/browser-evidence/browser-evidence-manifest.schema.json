{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/browser-evidence-manifest.schema.json",
  "title": "Browser evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "manifestType",
    "evidenceStatus",
    "journey",
    "capturedAt",
    "environment",
    "baseUrl",
    "browser",
    "viewport",
    "profile",
    "containsPersonalData",
    "steps"
  ],
  "properties": {
    "$schema": { "const": "./browser-evidence-manifest.schema.json" },
    "schemaVersion": { "const": 1 },
    "manifestType": { "enum": ["template", "evidence"] },
    "evidenceStatus": { "enum": ["not-collected", "collected"] },
    "journey": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": ["string", "null"], "format": "date-time" },
    "environment": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "format": "uri" },
    "browser": { "type": "string", "minLength": 1 },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "profile": { "type": "string", "minLength": 1 },
    "containsPersonalData": { "const": false },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "route",
          "expected",
          "artifact",
          "observed",
          "consoleNetworkNote",
          "mutationDisclosure",
          "outcome"
        ],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "route": { "type": "string", "pattern": "^/" },
          "expected": { "type": "string", "minLength": 1 },
          "artifact": { "type": ["string", "null"] },
          "observed": { "type": ["string", "null"] },
          "consoleNetworkNote": { "type": ["string", "null"] },
          "mutationDisclosure": { "type": ["string", "null"] },
          "outcome": { "enum": ["not-run", "pass", "fail"] }
        }
      }
    }
  }
}
